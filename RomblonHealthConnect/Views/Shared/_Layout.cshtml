@{
    var pageTitle = ViewData["Title"] as string ?? "Dashboard";
    var pageSubtitle = ViewData["Subtitle"] as string;
    var activeNav = ViewData["ActiveNav"] as string ?? "dashboard";

    // Marks a nav item active and sets aria-current in one place.
    Func<string, string> navClass = key => activeNav == key ? "sidebar-link is-active" : "sidebar-link";
    Func<string, string?> navCurrent = key => activeNav == key ? "page" : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle · Romblon HealthConnect</title>
    <meta name="description" content="Provincial health network monitoring and referral management for the Province of Romblon." />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* Cascade order: tokens and shell, then shared primitives, then modules. *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/command-palette.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/referrals.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="rhc-skip-link" href="#main-content">Skip to main content</a>

    @* data-workspace drives the Executive / Operations experience. *@
    <div class="app-shell" id="appShell" data-sidebar="expanded" data-mobile-nav="closed" data-workspace="operations">

        <!-- Navigation rail -->
        <aside class="app-sidebar" id="appSidebar">
            <div class="sidebar-brand">
                <span class="sidebar-brand-mark" aria-hidden="true">
                    <i class="fa-solid fa-heart-pulse"></i>
                </span>
                <span class="sidebar-brand-text">
                    <span class="sidebar-brand-name">HealthConnect</span>
                    <span class="sidebar-brand-sub">Province of Romblon</span>
                </span>
            </div>

            <nav class="sidebar-nav rhc-scroll" aria-label="Main navigation">

                <p class="sidebar-section-label">Overview</p>
                <ul class="sidebar-nav-list">
                    <li>
                        <a class="@navClass("dashboard")" asp-controller="Home" asp-action="Index"
                           aria-current="@navCurrent("dashboard")">
                            <span class="sidebar-link-icon" aria-hidden="true"><i class="fa-regular fa-map"></i></span>
                            <span class="sidebar-link-label">Provincial Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a class="@navClass("referrals-dashboard")" asp-controller="Referrals" asp-action="Index"
                           aria-current="@navCurrent("referrals-dashboard")">
                            <span class="sidebar-link-icon" aria-hidden="true"><i class="fa-regular fa-chart-bar"></i></span>
                            <span class="sidebar-link-label">Referral Overview</span>
                        </a>
                    </li>
                </ul>

                <p class="sidebar-section-label mode-operations-only">Facilities</p>
                <ul class="sidebar-nav-list mode-operations-only">
                    <li>
                        <a class="@navClass("hospitals")" asp-controller="Hospitals" asp-action="Index"
                           aria-current="@navCurrent("hospitals")">
                            <span class="sidebar-link-icon" aria-hidden="true"><i class="fa-regular fa-hospital"></i></span>
                            <span class="sidebar-link-label">Hospitals</span>
                        </a>
                    </li>
                </ul>

                <p class="sidebar-section-label mode-operations-only">Medical Staff</p>
                <ul class="sidebar-nav-list mode-operations-only">
                    <li>
                        <a class="@navClass("doctors")" href="#">
                            <span class="sidebar-link-icon" aria-hidden="true"><i class="fa-solid fa-user-doctor"></i></span>
                            <span class="sidebar-link-label">Doctors</span>
                        </a>
                    </li>
                    <li>
                        <a class="@navClass("specializations")" href="#">
                            <span class="sidebar-link-icon" aria-hidden="true"><i class="fa-solid fa-stethoscope"></i></span>
                            <span class="sidebar-link-label">Specializations</span>
                        </a>
                    </li>
                    <li>
                        <a class="@navClass("schedules")" href="#">
                            <span class="sidebar-link-icon" aria-hidden="true"><i class="fa-regular fa-calendar"></i></span>
                            <span class="sidebar-link-label">Schedules</span>
                        </a>
                    </li>
                </ul>

                <p class="sidebar-section-label mode-operations-only">Patients</p>
                <ul class="sidebar-nav-list mode-operations-only">
                    <li>
                        <a class="@navClass("patients")" href="#">
                            <span class="sidebar-link-icon" aria-hidden="true"><i class="fa-regular fa-address-card"></i></span>
                            <span class="sidebar-link-label">Patient Records</span>
                        </a>
                    </li>
                </ul>

                <p class="sidebar-section-label mode-operations-only">Referrals</p>
                <ul class="sidebar-nav-list mode-operations-only">
                    <li>
                        <a class="@navClass("referrals-create")" asp-controller="Referrals" asp-action="Create"
                           aria-current="@navCurrent("referrals-create")">
                            <span class="sidebar-link-icon" aria-hidden="true"><i class="fa-solid fa-plus"></i></span>
                            <span class="sidebar-link-label">Create Referral</span>
                        </a>
                    </li>
                    <li>
                        <a class="@navClass("referrals-incoming")" asp-controller="Referrals" asp-action="Incoming"
                           aria-current="@navCurrent("referrals-incoming")">
                            <span class="sidebar-link-icon" aria-hidden="true"><i class="fa-solid fa-inbox"></i></span>
                            <span class="sidebar-link-label">Incoming</span>
                        </a>
                    </li>
                    <li>
                        <a class="@navClass("referrals-outgoing")" asp-controller="Referrals" asp-action="Outgoing"
                           aria-current="@navCurrent("referrals-outgoing")">
                            <span class="sidebar-link-icon" aria-hidden="true"><i class="fa-solid fa-paper-plane"></i></span>
                            <span class="sidebar-link-label">Outgoing</span>
                        </a>
                    </li>
                    <li>
                        <a class="@navClass("referrals-pending")" asp-controller="Referrals" asp-action="Pending"
                           aria-current="@navCurrent("referrals-pending")">
                            <span class="sidebar-link-icon" aria-hidden="true"><i class="fa-regular fa-hourglass-half"></i></span>
                            <span class="sidebar-link-label">Pending</span>
                        </a>
                    </li>
                    <li>
                        <a class="@navClass("referrals-completed")" asp-controller="Referrals" asp-action="Completed"
                           aria-current="@navCurrent("referrals-completed")">
                            <span class="sidebar-link-icon" aria-hidden="true"><i class="fa-regular fa-circle-check"></i></span>
                            <span class="sidebar-link-label">Completed</span>
                        </a>
                    </li>
                    <li>
                        <a class="@navClass("referrals-archive")" asp-controller="Referrals" asp-action="Archive"
                           aria-current="@navCurrent("referrals-archive")">
                            <span class="sidebar-link-icon" aria-hidden="true"><i class="fa-regular fa-folder-open"></i></span>
                            <span class="sidebar-link-label">Archive</span>
                        </a>
                    </li>
                </ul>

                <p class="sidebar-section-label mode-operations-only">Operations</p>
                <ul class="sidebar-nav-list mode-operations-only">
                    <li>
                        <a class="@navClass("notifications")" href="#">
                            <span class="sidebar-link-icon" aria-hidden="true"><i class="fa-regular fa-bell"></i></span>
                            <span class="sidebar-link-label">Notifications</span>
                        </a>
                    </li>
                </ul>

                <p class="sidebar-section-label">Reports</p>
                <ul class="sidebar-nav-list">
                    <li>
                        <a class="@navClass("reports")" href="#">
                            <span class="sidebar-link-icon" aria-hidden="true"><i class="fa-solid fa-chart-line"></i></span>
                            <span class="sidebar-link-label">Analytics</span>
                        </a>
                    </li>
                </ul>

                <p class="sidebar-section-label mode-operations-only">Administration</p>
                <ul class="sidebar-nav-list mode-operations-only">
                    <li>
                        <a class="@navClass("settings")" href="#">
                            <span class="sidebar-link-icon" aria-hidden="true"><i class="fa-solid fa-gear"></i></span>
                            <span class="sidebar-link-label">Settings</span>
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="sidebar-footer">
                <button type="button" class="sidebar-toggle" id="sidebarToggle"
                        aria-controls="appSidebar" aria-expanded="true">
                    <span class="sidebar-toggle-icon" aria-hidden="true"><i class="fa-solid fa-angles-left"></i></span>
                    <span class="sidebar-toggle-label">Collapse</span>
                </button>
            </div>
        </aside>

        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <!-- Main column -->
        <div class="app-main">
            <header class="app-topbar">
                <button type="button" class="rhc-icon-btn topbar-menu-button" id="mobileNavToggle"
                        aria-controls="appSidebar" aria-expanded="false" aria-label="Open navigation menu">
                    <i class="fa-solid fa-bars" aria-hidden="true"></i>
                </button>

                <div class="topbar-heading">
                    <h1 class="topbar-title">@pageTitle</h1>
                    <p class="topbar-subtitle">
                        <span>Province of Romblon</span>
                        @if (!string.IsNullOrEmpty(pageSubtitle))
                        {
                            <span aria-hidden="true">·</span>
                            <span>@pageSubtitle</span>
                        }
                        <span aria-hidden="true">·</span>
                        <span id="currentDate">&mdash;</span>
                    </p>
                </div>

                <div class="topbar-actions">
                    <div class="mode-switch" role="group" aria-label="Workspace mode">
                        <button type="button" class="mode-switch-option" data-mode="executive" aria-pressed="false">
                            <i class="fa-solid fa-chart-pie" aria-hidden="true"></i>
                            <span>Executive</span>
                        </button>
                        <button type="button" class="mode-switch-option" data-mode="operations" aria-pressed="true">
                            <i class="fa-solid fa-list-check" aria-hidden="true"></i>
                            <span>Operations</span>
                        </button>
                    </div>

                    <span class="topbar-divider" aria-hidden="true"></span>

                    <div class="rhc-search">
                        <span class="rhc-search-icon" aria-hidden="true"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <button type="button" class="rhc-search-trigger" id="paletteTrigger"
                                aria-label="Search hospitals, doctors, patients, and referrals">
                            <span class="rhc-search-label">Search</span>
                            <span class="rhc-kbd" aria-hidden="true">Ctrl K</span>
                        </button>
                    </div>

                    <span class="topbar-divider" aria-hidden="true"></span>

                    <div class="topbar-status">
                        <span class="topbar-status-line">
                            <span class="live-dot" aria-hidden="true"></span>
                            <span id="networkStatusLabel">Network online</span>
                        </span>
                        <span class="topbar-status-meta">
                            Synced <span id="lastSyncLabel">just now</span>
                        </span>
                    </div>

                    <button type="button" class="rhc-icon-btn" id="notificationsButton"
                            aria-controls="notificationPanel" aria-expanded="false" aria-label="Notifications">
                        <i class="fa-regular fa-bell" aria-hidden="true"></i>
                        <span class="rhc-badge-dot" id="notificationBadge" aria-hidden="true" hidden></span>
                    </button>

                    <button type="button" class="topbar-profile" id="profileButton" aria-label="Account menu for J. Molino">
                        <span class="rhc-avatar" aria-hidden="true">JM</span>
                        <span class="topbar-profile-text">
                            <span class="topbar-profile-name">J. Molino</span>
                            <span class="topbar-profile-role">Provincial Administrator</span>
                        </span>
                    </button>
                </div>
            </header>

            <main class="app-content rhc-scroll" id="main-content">
                @RenderBody()
            </main>
        </div>

        <!-- Notification centre, populated by referrals.js -->
        <aside class="notification-panel" id="notificationPanel" aria-label="Notifications">
            <header class="notification-header">
                <h2 class="notification-title">Notifications</h2>
                <button type="button" class="rhc-btn rhc-btn-subtle rhc-btn-sm" id="markAllRead">Mark all read</button>
            </header>
            <ul class="notification-list rhc-scroll" id="notificationList">
                <li class="dash-empty"><span>Loading…</span></li>
            </ul>
        </aside>
    </div>

    <!-- Global command palette -->
    <div class="palette-backdrop" id="paletteBackdrop"></div>
    <div class="palette" id="commandPalette" role="dialog" aria-modal="true" aria-label="Global search">
        <div class="palette-header">
            <span class="palette-icon" aria-hidden="true"><i class="fa-solid fa-magnifying-glass"></i></span>
            <label class="rhc-visually-hidden" for="paletteInput">Search the provincial network</label>
            <input class="palette-input" id="paletteInput" type="text" autocomplete="off" spellcheck="false"
                   placeholder="Search hospitals, doctors, patients, referrals, municipalities…"
                   aria-controls="paletteResults" aria-expanded="true" role="combobox" aria-autocomplete="list" />
            <span class="rhc-kbd palette-esc" aria-hidden="true">Esc</span>
        </div>
        <ul class="palette-results rhc-scroll" id="paletteResults" role="listbox" aria-label="Search results"></ul>
        <div class="palette-footer">
            <span class="palette-hint"><span class="rhc-kbd">↑↓</span> Navigate</span>
            <span class="palette-hint"><span class="rhc-kbd">↵</span> Open</span>
            <span class="palette-hint"><span class="rhc-kbd">Esc</span> Close</span>
        </div>
    </div>

    @* Supplies the anti-forgery token to fetch-based POSTs in referrals.js. *@
    <form id="antiForgeryForm" aria-hidden="true" class="rhc-visually-hidden">@Html.AntiForgeryToken()</form>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/workspace-mode.js" asp-append-version="true"></script>
    <script src="~/js/command-palette.js" asp-append-version="true"></script>
    <script src="~/js/referrals.js" asp-append-version="true"></script>
    <script src="~/js/referral-realtime.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
