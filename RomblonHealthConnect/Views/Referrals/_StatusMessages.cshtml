@* Renders workflow feedback carried across a redirect. *@

@if (TempData["StatusMessage"] is string success)
{
    <div class="rhc-alert rhc-alert-success" role="status">
        <i class="fa-solid fa-circle-check rhc-alert-icon" aria-hidden="true"></i>
        <span>@success</span>
    </div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="rhc-alert rhc-alert-error" role="alert">
        <i class="fa-solid fa-circle-exclamation rhc-alert-icon" aria-hidden="true"></i>
        <span>@error</span>
    </div>
}
