@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Password reset";
}

<div class="auth-notice-icon auth-notice-icon-success" aria-hidden="true">
    <i class="fa-solid fa-check"></i>
</div>

<h1 class="auth-title">Password reset</h1>
<p class="auth-notice-body">Your password has been changed. You can now sign in.</p>

<a class="rhc-btn rhc-btn-primary rhc-btn-block" asp-action="Login">Go to sign in</a>
