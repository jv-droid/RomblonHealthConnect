@model RomblonHealthConnect.ViewModels.Account.ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset password";
}

<h1 class="auth-title">Choose a new password</h1>

<form method="post" asp-action="ResetPassword" class="auth-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Token" />
    <div asp-validation-summary="ModelOnly" class="rhc-alert rhc-alert-error"></div>

    <div class="filter-field">
        <label class="filter-label" asp-for="Email"></label>
        <input class="rhc-input" asp-for="Email" type="email" autocomplete="email" />
        <span class="rhc-field-error" asp-validation-for="Email"></span>
    </div>

    <div class="filter-field section-spaced">
        <label class="filter-label" asp-for="Password"></label>
        <input class="rhc-input" asp-for="Password" type="password" autocomplete="new-password" />
        <span class="rhc-field-error" asp-validation-for="Password"></span>
    </div>

    <div class="filter-field section-spaced">
        <label class="filter-label" asp-for="ConfirmPassword"></label>
        <input class="rhc-input" asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
        <span class="rhc-field-error" asp-validation-for="ConfirmPassword"></span>
    </div>

    <button type="submit" class="rhc-btn rhc-btn-primary rhc-btn-block section-spaced">Reset password</button>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
