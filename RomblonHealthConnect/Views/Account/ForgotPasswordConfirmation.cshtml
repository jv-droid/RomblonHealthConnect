@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Check your email";
}

<div class="auth-notice-icon auth-notice-icon-success" aria-hidden="true">
    <i class="fa-regular fa-envelope"></i>
</div>

<h1 class="auth-title">Check your email</h1>
<p class="auth-notice-body">
    If an account exists for that address, reset instructions have been sent.
</p>

<a class="rhc-btn rhc-btn-primary rhc-btn-block" asp-action="Login">Back to sign in</a>
