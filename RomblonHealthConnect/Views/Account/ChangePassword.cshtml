@model RomblonHealthConnect.ViewModels.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
    ViewData["Subtitle"] = "Account security";
}

<partial name="../Referrals/_StatusMessages" />

<section class="rhc-card" style="max-width:520px">
    <div class="rhc-card-header">
        <div class="rhc-card-heading">
            <h2 class="rhc-card-title">Change your password</h2>
            <p class="rhc-card-subtitle">Use at least 12 characters, including a symbol.</p>
        </div>
    </div>

    <form method="post" asp-action="ChangePassword" class="rhc-card-body">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="rhc-alert rhc-alert-error"></div>

        <div class="filter-field">
            <label class="filter-label" asp-for="CurrentPassword"></label>
            <input class="rhc-input" asp-for="CurrentPassword" type="password" autocomplete="current-password" />
            <span class="rhc-field-error" asp-validation-for="CurrentPassword"></span>
        </div>

        <div class="filter-field section-spaced">
            <label class="filter-label" asp-for="NewPassword"></label>
            <input class="rhc-input" asp-for="NewPassword" type="password" autocomplete="new-password" />
            <span class="rhc-field-error" asp-validation-for="NewPassword"></span>
        </div>

        <div class="filter-field section-spaced">
            <label class="filter-label" asp-for="ConfirmPassword"></label>
            <input class="rhc-input" asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
            <span class="rhc-field-error" asp-validation-for="ConfirmPassword"></span>
        </div>

        <button type="submit" class="rhc-btn rhc-btn-primary section-spaced">Update password</button>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
