@model RomblonHealthConnect.ViewModels.Account.ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot password";
}

<h1 class="auth-title">Reset your password</h1>
<p class="auth-notice-body">
    Enter the email address on your account and the Provincial Health Office will
    send reset instructions.
</p>

<form method="post" asp-action="ForgotPassword" class="auth-form">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="rhc-alert rhc-alert-error"></div>

    <div class="filter-field">
        <label class="filter-label" asp-for="Email"></label>
        <input class="rhc-input" asp-for="Email" type="email" autocomplete="email" autofocus />
        <span class="rhc-field-error" asp-validation-for="Email"></span>
    </div>

    <button type="submit" class="rhc-btn rhc-btn-primary rhc-btn-block section-spaced">Send instructions</button>
</form>

<p class="auth-footnote"><a asp-action="Login">Back to sign in</a></p>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
